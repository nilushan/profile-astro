---
// Mermaid diagram initialization component
// This component initializes Mermaid.js to render diagrams on the client side
---

<script>
  // Use dynamic import for better Vite compatibility
  const initMermaid = async () => {
    const mermaid = (await import('mermaid')).default;

    const config = {
      startOnLoad: false,
      theme: 'base',
      themeVariables: {
        primaryColor: 'oklch(var(--p))',
        primaryTextColor: 'oklch(var(--pc))',
        primaryBorderColor: 'oklch(var(--p))',
        lineColor: 'oklch(var(--bc) / 0.2)',
        secondaryColor: 'oklch(var(--s))',
        tertiaryColor: 'oklch(var(--a))',
        background: 'oklch(var(--b1))',
        mainBkg: 'oklch(var(--b1))',
        textColor: 'oklch(var(--bc))',
        fontSize: '16px',
      },
      securityLevel: 'loose',
      fontFamily: 'var(--font-family-sans)',
    };

    mermaid.initialize(config);

    // Find all mermaid code blocks and render them
    const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');

    mermaidBlocks.forEach((block, index) => {
      const code = block.querySelector('code');
      if (!code) return;

      // Get the diagram text content
      const diagramText = code.textContent || '';

      // Create a div to hold the rendered diagram
      const diagramDiv = document.createElement('div');
      diagramDiv.className = 'mermaid-diagram';
      diagramDiv.id = `mermaid-${index}`;

      // Replace the pre/code block with the diagram div
      block.parentNode?.replaceChild(diagramDiv, block);

      // Render the diagram
      mermaid.render(`mermaid-svg-${index}`, diagramText).then(({ svg }) => {
        diagramDiv.innerHTML = svg;
      }).catch((error) => {
        console.error('Mermaid rendering error:', error);
        // On error, show the original code block
        diagramDiv.parentNode?.replaceChild(block, diagramDiv);
      });
    });

    // Re-initialize Mermaid when theme changes
    window.addEventListener('theme-changed', async () => {
      // Reload the page to re-render diagrams with new theme
      // This is simpler than trying to re-render in place
      setTimeout(() => {
        location.reload();
      }, 100);
    });
  };

  // Initialize Mermaid when the DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMermaid);
  } else {
    initMermaid();
  }
</script>

<style is:global>
  /* Diagram preview container */
  .diagram-preview {
    margin: 2rem 0;
    border: 2px solid oklch(var(--bc) / 0.1);
    border-radius: 0.75rem;
    overflow: hidden;
    background: oklch(var(--b2));
  }

  .diagram-preview-header {
    background: oklch(var(--b3));
    padding: 0.75rem 1rem;
    border-bottom: 1px solid oklch(var(--bc) / 0.1);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .diagram-preview-header svg {
    width: 1.25rem;
    height: 1.25rem;
    color: oklch(var(--p));
  }

  .diagram-preview-header span {
    font-weight: 600;
    font-size: 0.875rem;
    color: oklch(var(--bc) / 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Ensure Mermaid diagrams are visible and properly styled */
  .mermaid-diagram {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
    background: oklch(var(--b1));
    overflow-x: auto;
    min-height: 200px;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .mermaid-diagram svg {
    max-width: 100%;
    height: auto;
  }

  /* Code block styling for mermaid syntax */
  .diagram-code {
    margin: 1.5rem 0;
    position: relative;
  }

  .diagram-code-header {
    background: oklch(var(--b3));
    padding: 0.5rem 1rem;
    border-bottom: 1px solid oklch(var(--bc) / 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.5rem 0.5rem 0 0;
  }

  .diagram-code-header span {
    font-size: 0.75rem;
    font-weight: 600;
    color: oklch(var(--bc) / 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .diagram-code pre {
    margin: 0;
    border-radius: 0 0 0.5rem 0.5rem;
  }
</style>
