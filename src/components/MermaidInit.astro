---
// Mermaid diagram initialization component
// This component initializes Mermaid.js to render diagrams on the client side
---

<script>
  // Use dynamic import for better Vite compatibility
  const initMermaid = async () => {
    const mermaid = (await import('mermaid')).default;

    const config = {
      startOnLoad: true,
      theme: 'base',
      themeVariables: {
        primaryColor: 'oklch(var(--p))',
        primaryTextColor: 'oklch(var(--pc))',
        primaryBorderColor: 'oklch(var(--p))',
        lineColor: 'oklch(var(--bc) / 0.2)',
        secondaryColor: 'oklch(var(--s))',
        tertiaryColor: 'oklch(var(--a))',
        background: 'oklch(var(--b1))',
        mainBkg: 'oklch(var(--b1))',
        textColor: 'oklch(var(--bc))',
        fontSize: '16px',
      },
      securityLevel: 'loose',
      fontFamily: 'var(--font-family-sans)',
    };

    mermaid.initialize(config);

    // Run Mermaid on all code blocks with language-mermaid class
    await mermaid.run({
      querySelector: 'code.language-mermaid',
    });

    // Re-initialize Mermaid when theme changes
    window.addEventListener('theme-changed', async () => {
      // Small delay to ensure CSS variables are updated
      setTimeout(async () => {
        mermaid.initialize(config);

        // Re-render all diagrams
        const mermaidElements = document.querySelectorAll('code.language-mermaid');
        mermaidElements.forEach((element) => {
          element.removeAttribute('data-processed');
        });

        await mermaid.run({
          querySelector: 'code.language-mermaid',
        });
      }, 100);
    });
  };

  // Initialize Mermaid when the DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMermaid);
  } else {
    initMermaid();
  }
</script>

<style is:global>
  /* Diagram preview container */
  .diagram-preview {
    margin: 2rem 0;
    border: 2px solid oklch(var(--bc) / 0.1);
    border-radius: 0.75rem;
    overflow: hidden;
    background: oklch(var(--b2));
  }

  .diagram-preview-header {
    background: oklch(var(--b3));
    padding: 0.75rem 1rem;
    border-bottom: 1px solid oklch(var(--bc) / 0.1);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .diagram-preview-header svg {
    width: 1.25rem;
    height: 1.25rem;
    color: oklch(var(--p));
  }

  .diagram-preview-header span {
    font-weight: 600;
    font-size: 0.875rem;
    color: oklch(var(--bc) / 0.7);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Ensure Mermaid diagrams are visible and properly styled */
  code.language-mermaid {
    display: flex !important;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
    background: oklch(var(--b1)) !important;
    overflow-x: auto;
    min-height: 200px;
  }

  code.language-mermaid svg {
    max-width: 100%;
    height: auto;
  }

  /* Code block styling for mermaid syntax */
  .diagram-code {
    margin: 1.5rem 0;
    position: relative;
  }

  .diagram-code-header {
    background: oklch(var(--b3));
    padding: 0.5rem 1rem;
    border-bottom: 1px solid oklch(var(--bc) / 0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.5rem 0.5rem 0 0;
  }

  .diagram-code-header span {
    font-size: 0.75rem;
    font-weight: 600;
    color: oklch(var(--bc) / 0.6);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .diagram-code pre {
    margin: 0;
    border-radius: 0 0 0.5rem 0.5rem;
  }
</style>
