---
/**
 * DynamicImage Component
 *
 * Handles dynamic image paths from CMS or content collections
 * Automatically resolves images at build time without hardcoding mappings
 *
 * @example
 * <DynamicImage
 *   src="/images/projects/iotdashboard.png"
 *   alt="IoT Dashboard"
 *   loading="lazy"
 *   class="w-full rounded-lg"
 * />
 */

import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { resolveImage } from '@/lib/image-utils';

interface Props {
  /** Image path from content (e.g., '/images/projects/example.png') */
  src: string | undefined;
  /** Alt text for accessibility */
  alt: string;
  /** Optional caption to display below image */
  caption?: string;
  /** Loading strategy: 'lazy' (default) or 'eager' */
  loading?: 'lazy' | 'eager';
  /** Optional width constraint */
  width?: number;
  /** Optional height constraint */
  height?: number;
  /** Additional CSS classes */
  class?: string;
}

const {
  src,
  alt,
  caption,
  loading = 'lazy',
  width,
  height,
  class: className
} = Astro.props;

// Resolve image at build time using the static image map
const imageData = resolveImage(src);

// If image not found, log a warning in development
if (!imageData && src) {
  console.warn(`[DynamicImage] Image not found: ${src}`);
}
---

{imageData ? (
  <figure class={caption ? 'figure-with-caption' : ''}>
    <Image
      src={imageData}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      class={className}
      decoding="async"
    />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
) : (
  <div class="placeholder-image" role="img" aria-label={alt}>
    <div class="placeholder-content">
      <svg class="placeholder-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <p class="placeholder-text">Image not found: {src}</p>
    </div>
  </div>
)}

<style>
  figure {
    margin: 1.5rem 0;
  }

  figure.figure-with-caption {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  figcaption {
    font-size: 0.875rem;
    color: var(--color-text-secondary, #6b7280);
    margin-top: 0.5rem;
    text-align: center;
    max-width: 100%;
  }

  .placeholder-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 250px;
    background: linear-gradient(135deg, var(--color-bg-secondary, #f3f4f6) 0%, var(--color-bg-tertiary, #e5e7eb) 100%);
    border-radius: 0.5rem;
    border: 2px dashed var(--color-border, #d1d5db);
  }

  .placeholder-content {
    text-align: center;
    padding: 2rem;
  }

  .placeholder-icon {
    width: 3rem;
    height: 3rem;
    margin-bottom: 1rem;
    color: var(--color-text-tertiary, #9ca3af);
  }

  .placeholder-text {
    color: var(--color-text-secondary, #6b7280);
    font-size: 0.875rem;
    word-break: break-all;
  }
</style>
