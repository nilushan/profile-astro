---
/**
 * SplitScreen Component
 * Alternative to card-based layouts for project showcase
 * Features: Asymmetric two-column layout with sticky content and visual hierarchy
 */
export interface Project {
  title: string;
  description: string;
  period: string;
  technologies: string[];
  achievements?: string[];
  status?: string;
  category?: string;
}

export interface Props {
  projects: Project[];
  direction?: 'left' | 'right'; // Which side should be sticky
}

const { projects, direction = 'left' } = Astro.props;
---

<div class="space-y-24">
  {projects.map((project, index) => {
    // Alternate the layout direction
    const isLeftSticky = direction === 'left' ? index % 2 === 0 : index % 2 === 1;
    const stickyClass = isLeftSticky ? 'lg:sticky' : '';
    const orderClass = isLeftSticky ? '' : 'lg:order-2';

    return (
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12 items-start scroll-reveal" data-delay={index % 3 + 1}>
        <!-- Project Visual/Info Side (Sticky) -->
        <div class={`lg:col-span-2 ${stickyClass} ${orderClass} lg:top-24 space-y-6`}>
          <!-- Project Number Badge -->
          <div class="flex items-center gap-4">
            <div class="w-16 h-16 bg-gradient-to-br from-primary to-secondary rounded-2xl flex items-center justify-center shadow-xl">
              <span class="text-2xl font-display font-bold text-white">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            {project.status && (
              <div class="badge badge-primary badge-lg font-mono shadow-lg">
                {project.status}
              </div>
            )}
          </div>

          <!-- Project Title -->
          <h3 class="text-4xl lg:text-5xl font-display font-bold text-base-content leading-tight">
            {project.title}
          </h3>

          <!-- Period -->
          <div class="flex items-center gap-2 text-base-content/60">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
            </svg>
            <span class="font-mono text-sm">{project.period}</span>
          </div>

          <!-- Category Badge -->
          {project.category && (
            <div class="inline-flex">
              <div class="badge badge-outline badge-lg">
                {project.category}
              </div>
            </div>
          )}

          <!-- Technologies Stack -->
          <div class="space-y-3">
            <h4 class="font-display font-bold text-sm uppercase tracking-wider text-base-content/60">
              Tech Stack
            </h4>
            <div class="flex flex-wrap gap-2">
              {project.technologies.map((tech) => (
                <div class="badge badge-secondary font-mono hover:scale-105 transition-transform">
                  {tech}
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Project Content Side -->
        <div class={`lg:col-span-3 ${isLeftSticky ? '' : 'lg:order-1'} space-y-6`}>
          <!-- Description -->
          <div class="prose prose-lg max-w-none">
            <p class="text-base-content/80 leading-relaxed text-lg">
              {project.description}
            </p>
          </div>

          <!-- Achievements -->
          {project.achievements && project.achievements.length > 0 && (
            <div class="space-y-4">
              <h4 class="font-display font-bold text-xl text-accent flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Key Achievements
              </h4>
              <div class="space-y-3">
                {project.achievements.map((achievement) => (
                  <div class="flex items-start gap-3 p-4 bg-base-200/50 rounded-lg border-l-4 border-accent hover:bg-base-200 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5 text-accent flex-shrink-0 mt-0.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span class="text-base-content/80 leading-relaxed">{achievement}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Visual Divider -->
          <div class="h-px bg-gradient-to-r from-transparent via-base-content/20 to-transparent"></div>

          <!-- Project Stats (if applicable) -->
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="bg-gradient-to-br from-primary/10 to-primary/5 p-4 rounded-lg border border-primary/20">
              <div class="text-2xl font-display font-bold text-primary">
                {project.technologies.length}+
              </div>
              <div class="text-xs font-mono text-base-content/60 uppercase tracking-wider mt-1">
                Technologies
              </div>
            </div>
            {project.achievements && (
              <div class="bg-gradient-to-br from-accent/10 to-accent/5 p-4 rounded-lg border border-accent/20">
                <div class="text-2xl font-display font-bold text-accent">
                  {project.achievements.length}
                </div>
                <div class="text-xs font-mono text-base-content/60 uppercase tracking-wider mt-1">
                  Achievements
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    );
  })}
</div>

<style>
  /* Smooth reveal animation */
  .scroll-reveal {
    opacity: 0;
    transform: translateY(30px);
    animation: revealUp 0.8s ease-out forwards;
  }

  .scroll-reveal[data-delay="1"] {
    animation-delay: 0.1s;
  }

  .scroll-reveal[data-delay="2"] {
    animation-delay: 0.2s;
  }

  .scroll-reveal[data-delay="3"] {
    animation-delay: 0.3s;
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Sticky positioning adjustment for better spacing */
  @media (min-width: 1024px) {
    .lg\:sticky {
      position: sticky;
      top: 6rem;
    }
  }
</style>
