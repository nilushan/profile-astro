---
/**
 * BentoGrid Component
 * Alternative to uniform card grids for mixed content display
 * Features: Irregular grid with varying sizes, Pinterest-style layout
 */
export interface BentoItem {
  title: string;
  description?: string;
  content?: string;
  size?: 'small' | 'medium' | 'large' | 'wide' | 'tall';
  color?: 'primary' | 'secondary' | 'accent' | 'info' | 'success' | 'warning' | 'neutral';
  icon?: string;
  link?: string;
  tags?: string[];
  stat?: {
    value: string;
    label: string;
  };
}

export interface Props {
  items: BentoItem[];
  columns?: 3 | 4 | 5;
}

const { items, columns = 4 } = Astro.props;

// Grid column classes
const gridCols = {
  3: 'lg:grid-cols-3',
  4: 'lg:grid-cols-4',
  5: 'lg:grid-cols-5',
};

// Size classes for bento items
const sizeClasses = {
  small: 'lg:col-span-1 lg:row-span-1',
  medium: 'lg:col-span-2 lg:row-span-1',
  large: 'lg:col-span-2 lg:row-span-2',
  wide: 'lg:col-span-3 lg:row-span-1',
  tall: 'lg:col-span-1 lg:row-span-2',
};

// Color classes
const colorClasses = {
  primary: {
    bg: 'bg-gradient-to-br from-primary/20 via-primary/10 to-transparent',
    border: 'border-primary/30',
    text: 'text-primary',
    iconBg: 'bg-primary',
  },
  secondary: {
    bg: 'bg-gradient-to-br from-secondary/20 via-secondary/10 to-transparent',
    border: 'border-secondary/30',
    text: 'text-secondary',
    iconBg: 'bg-secondary',
  },
  accent: {
    bg: 'bg-gradient-to-br from-accent/20 via-accent/10 to-transparent',
    border: 'border-accent/30',
    text: 'text-accent',
    iconBg: 'bg-accent',
  },
  info: {
    bg: 'bg-gradient-to-br from-info/20 via-info/10 to-transparent',
    border: 'border-info/30',
    text: 'text-info',
    iconBg: 'bg-info',
  },
  success: {
    bg: 'bg-gradient-to-br from-success/20 via-success/10 to-transparent',
    border: 'border-success/30',
    text: 'text-success',
    iconBg: 'bg-success',
  },
  warning: {
    bg: 'bg-gradient-to-br from-warning/20 via-warning/10 to-transparent',
    border: 'border-warning/30',
    text: 'text-warning',
    iconBg: 'bg-warning',
  },
  neutral: {
    bg: 'bg-base-200/50',
    border: 'border-base-content/10',
    text: 'text-base-content',
    iconBg: 'bg-base-content',
  },
};

// Icon mapping
const getIconSvg = (iconName?: string) => {
  if (!iconName) return null;

  const icons: Record<string, string> = {
    star: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />`,
    rocket: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 01-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 006.16-12.12A14.98 14.98 0 009.631 8.41m5.96 5.96a14.926 14.926 0 01-5.841 2.58m-.119-8.54a6 6 0 00-7.381 5.84h4.8m2.581-5.84a14.927 14.927 0 00-2.58 5.84m2.699 2.7c-.103.021-.207.041-.311.06a15.09 15.09 0 01-2.448-2.448 14.9 14.9 0 01.06-.312m-2.24 2.39a4.493 4.493 0 00-1.757 4.306 4.493 4.493 0 004.306-1.758M16.5 9a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />`,
    code: `<path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />`,
    chart: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />`,
    lightbulb: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18" />`,
    heart: `<path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />`,
    trophy: `<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0" />`,
  };

  return icons[iconName] || null;
};
---

<div class={`grid grid-cols-1 md:grid-cols-2 ${gridCols[columns]} gap-4 auto-rows-auto`}>
  {items.map((item, index) => {
    const size = item.size || 'small';
    const color = item.color || 'neutral';
    const colors = colorClasses[color];
    const iconSvg = getIconSvg(item.icon);

    return (
      <div
        class={`${sizeClasses[size]} group relative overflow-hidden rounded-2xl border-2 ${colors.border} ${colors.bg} backdrop-blur-sm transition-all duration-500 hover:scale-[1.02] hover:shadow-2xl scroll-reveal`}
        data-delay={index % 3 + 1}
      >
        {/* Background gradient orb */}
        <div class={`absolute -top-20 -right-20 w-40 h-40 ${colors.iconBg} opacity-10 rounded-full blur-3xl group-hover:opacity-20 transition-opacity`}></div>

        <div class="relative z-10 p-6 h-full flex flex-col">
          {/* Icon */}
          {iconSvg && (
            <div class={`w-12 h-12 ${colors.iconBg} rounded-xl flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform`}>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2"
                stroke="currentColor"
                class="w-6 h-6 text-white"
                set:html={iconSvg}
              >
              </svg>
            </div>
          )}

          {/* Title */}
          <h3 class={`text-xl lg:text-2xl font-display font-bold ${colors.text} mb-3 leading-tight`}>
            {item.title}
          </h3>

          {/* Description */}
          {item.description && (
            <p class="text-base-content/70 mb-4 leading-relaxed flex-grow">
              {item.description}
            </p>
          )}

          {/* Content */}
          {item.content && (
            <div class="text-base-content/60 text-sm mb-4">
              {item.content}
            </div>
          )}

          {/* Stat */}
          {item.stat && (
            <div class="mb-4">
              <div class={`text-4xl font-display font-bold ${colors.text} mb-1`}>
                {item.stat.value}
              </div>
              <div class="text-xs font-mono text-base-content/60 uppercase tracking-wider">
                {item.stat.label}
              </div>
            </div>
          )}

          {/* Tags */}
          {item.tags && item.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-auto">
              {item.tags.map((tag) => (
                <div class="badge badge-sm badge-outline font-mono">
                  {tag}
                </div>
              ))}
            </div>
          )}

          {/* Link Arrow */}
          {item.link && (
            <a
              href={item.link}
              class={`mt-4 inline-flex items-center gap-2 ${colors.text} hover:gap-3 transition-all group-hover:underline`}
            >
              <span class="font-mono text-sm font-semibold">Learn more</span>
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          )}
        </div>
      </div>
    );
  })}
</div>

<style>
  /* Smooth reveal animation */
  .scroll-reveal {
    opacity: 0;
    transform: scale(0.95);
    animation: revealScale 0.6s ease-out forwards;
  }

  .scroll-reveal[data-delay="1"] {
    animation-delay: 0.1s;
  }

  .scroll-reveal[data-delay="2"] {
    animation-delay: 0.2s;
  }

  .scroll-reveal[data-delay="3"] {
    animation-delay: 0.3s;
  }

  @keyframes revealScale {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Auto-fit grid items */
  .auto-rows-auto {
    grid-auto-rows: minmax(200px, auto);
  }
</style>
