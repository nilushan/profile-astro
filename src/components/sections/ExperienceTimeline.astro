---
import ExpandableSection from '@/components/interactive/ExpandableSection';

export interface ExperienceItem {
  id: string;
  title: string;
  company: string;
  location: string;
  period: string;
  type: string;
  description?: string;
  highlights: Array<{
    title: string;
    description: string;
  }>;
  technologies: string[];
}

export interface Props {
  experiences: ExperienceItem[];
  showAll?: boolean;
  maxItems?: number;
  summary?: boolean;
}

const { experiences, showAll = false, maxItems = 3, summary = false } = Astro.props;
const displayedExperiences = showAll ? experiences : experiences.slice(0, maxItems);

// Function to get company initials for avatar
const getCompanyInitials = (company: string) => {
  return company
    .split(' ')
    .map(word => word[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
};

// Function to determine if position is current
const isCurrent = (period: string) => {
  return period.toLowerCase().includes('present') || period.toLowerCase().includes('current');
};
---

<div class="relative">
  <!-- Central Timeline Line -->
  <div class="absolute left-10 top-0 bottom-0 w-1 bg-gradient-to-b from-primary via-secondary to-accent hidden lg:block"></div>

  {displayedExperiences.map((experience, index) => (
    <div class="relative mb-16 last:mb-0">
      <!-- Timeline Node -->
      <div class="absolute left-6 top-8 w-9 h-9 bg-gradient-to-br from-primary to-secondary rounded-full border-4 border-base-100 shadow-xl z-20 hidden lg:flex items-center justify-center">
        <div class="w-2 h-2 bg-base-100 rounded-full"></div>
      </div>

      <!-- Timeline Connector Dot -->
      {index < displayedExperiences.length - 1 && (
        <div class="absolute left-10 top-32 w-1 h-16 bg-gradient-to-b from-transparent via-base-300 to-transparent -z-10 hidden lg:block"></div>
      )}

      <div class="card bg-base-100 shadow-2xl hover:shadow-2xl hover:scale-[1.01] transition-all duration-500 group border border-base-content/5 hover:border-primary/20 glass relative overflow-hidden lg:ml-24">
        <!-- Gradient accent -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary via-secondary to-accent"></div>
        <!-- Floating orb -->
        <div class="absolute -top-20 -right-20 w-40 h-40 bg-primary/10 rounded-full blur-3xl group-hover:bg-primary/20 transition-all"></div>

        <div class="card-body relative z-10">
          <div class="flex flex-col lg:flex-row lg:items-start gap-6">
            <!-- Enhanced Company Avatar -->
            <div class="flex-shrink-0 relative">
              <div class="avatar placeholder">
                <div class="bg-gradient-to-br from-primary to-secondary text-primary-content w-20 h-20 rounded-2xl ring-4 ring-primary/20 ring-offset-base-100 ring-offset-2 shadow-xl group-hover:scale-110 transition-transform duration-300">
                  <span class="text-xl font-display font-bold items-center justify-around flex h-full w-full">
                    {getCompanyInitials(experience.company)}
                  </span>
                </div>
              </div>
              <!-- Current position indicator -->
              {isCurrent(experience.period) && (
                <div class="absolute -bottom-1 -right-1">
                  <div class="flex h-4 w-4">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-4 w-4 bg-success"></span>
                  </div>
                </div>
              )}
            </div>

            <!-- Experience Content -->
            <div class="flex-1 min-w-0">
              <!-- Header -->
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                <div>
                  <h3 class="card-title text-2xl lg:text-3xl font-display group-hover:text-primary transition-colors">
                    {experience.title}
                  </h3>
                  <h4 class="text-lg font-semibold text-base-content/70 mt-2 flex items-center gap-2">
                    <span>{experience.company}</span>
                    <span class="text-base-content/40">•</span>
                    <span class="font-mono text-sm">{experience.location}</span>
                  </h4>
                </div>
                <div class="flex flex-col sm:items-end gap-2 mt-4 sm:mt-0">
                  <div class="badge badge-primary badge-lg font-mono shadow-lg">
                    {experience.period}
                  </div>
                  {isCurrent(experience.period) && (
                    <div class="badge badge-success gap-1">
                      <div class="w-2 h-2 bg-current rounded-full animate-pulse"></div>
                      Current
                    </div>
                  )}
                </div>
              </div>

              <!-- Description -->
              {experience.description && (
                <p class="text-base-content/70 mb-6 text-base leading-relaxed">
                  {experience.description}
                </p>
              )}

              <!-- Key Highlights - Expandable -->
              {!summary && (
                <ExpandableSection
                  client:load
                  title="Key Achievements"
                  items={experience.highlights}
                  defaultExpanded={index === 0}
                />
              )}

              <!-- Enhanced Technologies -->
              <div>
                <h5 class="font-display font-semibold text-base-content mb-4 flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-secondary">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
                  </svg>
                  <span class="font-mono text-sm uppercase tracking-wider">Tech Stack</span>
                </h5>
                <div class="flex flex-wrap gap-2">
                  {experience.technologies.map((tech) => (
                    <div class="badge badge-outline hover:badge-primary hover:scale-110 transition-all cursor-default font-mono text-xs shadow-sm">
                      {tech}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  ))}

  <!-- View More Button -->
  {!showAll && experiences.length > maxItems && (
    <div class="text-center mt-8">
      <a href="/experience" class="btn btn-outline btn-lg group">
        <span>View Full Experience</span>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 transition-transform group-hover:translate-x-1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  )}
</div>
