---
import { portfolioData } from "@/data/portfolio";
import {
    generateSocialLinksWithMetadata,
    getSocialIcon,
} from "@/lib/social-links";
import CountUp from "@/components/interactive/CountUp";

const { personal } = portfolioData;

// Get initials for avatar fallback
const initials = personal.name
    .split(" ")
    .map((n) => n[0])
    .join("");

// Generate social links with metadata
const socialLinks = generateSocialLinksWithMetadata(personal);
---

<section class="hero min-h-[calc(100vh-5rem)] relative overflow-hidden tech-grid">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 animated-gradient opacity-50"></div>

    <!-- Diagonal accent line -->
    <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary via-secondary to-accent"></div>

    <div class="container mx-auto px-4 relative z-10">
        <div
            class="flex flex-col lg:flex-row-reverse gap-8 lg:gap-16 items-center py-8 lg:py-20"
        >
            <!-- Avatar Section with Enhanced Design -->
            <div class="flex-shrink-0 flex flex-col items-center reveal-item reveal-item-delay-1">
                <div class="relative">
                    <!-- Floating geometric background -->
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/20 to-secondary/20 rounded-3xl transform rotate-6 scale-105 blur-2xl"></div>

                    <div class="avatar placeholder relative z-10">
                        <div
                            class="bg-gradient-to-br from-primary to-secondary text-primary-content w-48 sm:w-56 lg:w-72 rounded-3xl ring-4 ring-primary/30 ring-offset-base-100 ring-offset-4 flex items-center shadow-2xl glow-hover transition-all duration-500 hover:scale-105"
                        >
                            <div
                                class="text-6xl sm:text-7xl lg:text-8xl font-display items-center justify-around flex h-full w-full"
                            >
                                {initials}
                            </div>
                        </div>
                    </div>

                    <!-- Floating badge -->
                    <div class="absolute -bottom-4 left-1/2 -translate-x-1/2 w-max">
                        <div
                            class="badge badge-success badge-lg gap-2 text-success-content shadow-lg glass backdrop-blur-md"
                        >
                            <div
                                class="h-2 w-2 rounded-full bg-current animate-pulse"
                            >
                            </div>
                            <span class="font-mono text-xs">AVAILABLE_FOR_HIRE</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Content Section with Enhanced Typography -->
            <div class="text-center lg:text-left flex-1 space-y-6">
                <!-- Overline label -->
                <div class="reveal-item reveal-item-delay-2">
                    <span class="font-mono text-sm text-primary uppercase tracking-wider">
                        &lt; Full Stack Engineer /&gt;
                    </span>
                </div>

                <h1
                    class="text-4xl sm:text-6xl lg:text-8xl xl:text-9xl font-display font-bold text-base-content reveal-item reveal-item-delay-3 leading-tight mb-6"
                >
                    {personal.title}
                </h1>

                <!-- Hero Summary - concise description -->
                <p class="text-base sm:text-lg lg:text-xl leading-relaxed text-base-content/80 mb-8 max-w-3xl reveal-item reveal-item-delay-5">
                    {personal.heroSummary}
                </p>

                <div
                    class="flex flex-wrap justify-center gap-3 mb-8 lg:justify-start reveal-item reveal-item-delay-6"
                >
                    <div class="badge badge-primary badge-lg font-mono shadow-lg hover:scale-110 transition-transform cursor-default glow">
                        TypeScript Expert
                    </div>
                    <div class="badge badge-secondary badge-lg font-mono shadow-lg hover:scale-110 transition-transform cursor-default">
                        GCP Architect
                    </div>
                    <div class="badge badge-accent badge-lg font-mono shadow-lg hover:scale-110 transition-transform cursor-default">
                        IoT Specialist
                    </div>
                    <div class="badge badge-info badge-lg font-mono shadow-lg hover:scale-110 transition-transform cursor-default">DevOps Engineer</div>
                </div>

                <!-- Enhanced CTA Buttons -->
                <div
                    class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start reveal-item reveal-item-delay-7"
                >
                    <a href="/about" class="btn btn-primary btn-lg font-display shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 glow-hover group">
                        <span>Learn More About Me</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="h-5 w-5 ml-2 transition-transform group-hover:translate-x-1"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                        </svg>
                    </a>

                    <a href="/projects" class="btn btn-outline btn-lg font-display shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 group border-2">
                        <span>View Projects</span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="h-5 w-5 transition-transform group-hover:translate-x-1"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                        </svg>
                    </a>
                </div>

                <!-- Enhanced Stats Section with Glass Effect -->
                <div
                    class="stats stats-vertical sm:stats-horizontal shadow-2xl mt-12 glass text-base-content w-full sm:w-auto reveal-item reveal-item-delay-8 border border-primary/20"
                >
                    <div class="stat place-items-center sm:place-items-start hover:bg-primary/5 transition-colors">
                        <div class="stat-figure text-primary">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="h-10 w-10"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                                ></path>
                            </svg>
                        </div>
                        <div class="stat-title text-base-content/60 font-mono text-xs uppercase tracking-wider">
                            Experience
                        </div>
                        <div
                            class="stat-value text-4xl lg:text-5xl font-display gradient-text"
                        >
                            <CountUp client:visible end={personal.yearsExperience} suffix="+" />
                        </div>
                        <div class="stat-desc text-base-content/60 font-mono text-sm">
                            Years in Tech
                        </div>
                    </div>

                    <!-- <div class="stat place-items-center sm:place-items-start">
          <div class="stat-figure text-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6" />
            </svg>
          </div>
          <div class="stat-title text-base-content/60">Projects</div>
          <div class="stat-value text-3xl lg:text-4xl text-secondary">50+</div>
          <div class="stat-desc text-base-content/60">Successfully Delivered</div>
        </div> -->

                    <div class="stat place-items-center sm:place-items-start hover:bg-accent/5 transition-colors">
                        <div class="stat-figure text-accent">
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="h-10 w-10"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"
                                ></path>
                            </svg>
                        </div>
                        <div class="stat-title text-base-content/60 font-mono text-xs uppercase tracking-wider">
                            Technologies
                        </div>
                        <div
                            class="stat-value text-4xl lg:text-5xl font-display text-accent"
                        >
                            <CountUp client:visible end={25} suffix="+" />
                        </div>
                        <div class="stat-desc text-base-content/60 font-mono text-sm">
                            In Production
                        </div>
                    </div>
                </div>

                <!-- Enhanced Quick Links -->
                <div
                    class="flex flex-wrap gap-3 mt-8 justify-center lg:justify-start"
                >
                    {
                        socialLinks.map((link, index) => (
                            <a
                                href={link.url}
                                target={link.external ? "_blank" : undefined}
                                rel={
                                    link.external
                                        ? "noopener noreferrer"
                                        : undefined
                                }
                                class={`btn btn-ghost btn-sm gap-2 glass border border-base-content/10 hover:border-primary hover:bg-primary/10 transition-all duration-300 hover:scale-110 font-mono reveal-item reveal-item-delay-${index + 1}`}
                                aria-label={link.ariaLabel}
                            >
                                <Fragment
                                    set:html={getSocialIcon(link.platform)}
                                />
                                <span>{link.name}</span>
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>
