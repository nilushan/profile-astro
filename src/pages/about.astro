---
export const prerender = true;

import Layout from '@/layouts/Layout.astro'
import CallToAction from '@/components/CallToAction.astro'
import { portfolioData } from '@/data/portfolio'

const { personal, education, interests, currentLearning, ctas } = portfolioData
const cta = ctas.about
const startYear = 2008
const currentYear = new Date().getFullYear()
const yearsExperience = currentYear - startYear

// Journey milestones
const journeyMilestones = [
  { year: '2008', title: 'Started Journey', description: 'Began studying Computer Science at University of Colombo', icon: 'graduation' },
  { year: '2010', title: 'First Role', description: 'Started professional career in software development', icon: 'code' },
  { year: '2015', title: 'Cloud Era', description: 'Specialized in cloud architecture and DevOps', icon: 'cloud' },
  { year: '2020', title: 'IoT Focus', description: 'Led large-scale IoT platform development', icon: 'devices' },
  { year: currentYear.toString(), title: 'Current', description: 'Building scalable systems at scale', icon: 'rocket' }
]

// Personal facts
const funFacts = [
  { icon: 'location', label: 'Based in', value: personal.location },
  { icon: 'code', label: 'Years Coding', value: `${yearsExperience}+` },
  { icon: 'coffee', label: 'Favorite Fuel', value: 'Coffee ☕' },
  { icon: 'time', label: 'Timezone', value: 'AEST (GMT+10)' }
]
---

<Layout title={`About ${personal.name}`} description="Learn more about my background, journey, and interests in software development and cloud engineering.">
  <!-- Hero Section with Personal Touch -->
  <section class="hero min-h-[400px] sm:min-h-[500px] relative overflow-hidden">
    <!-- Animated background -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-secondary/5 to-accent/10"></div>
    <div class="absolute inset-0 tech-grid opacity-30"></div>

    <div class="hero-content text-center relative z-10 w-full py-12 sm:py-16 lg:py-20">
      <div class="max-w-4xl mx-auto">
        <!-- Avatar -->
        <div class="avatar placeholder mb-6 sm:mb-8">
          <div class="bg-gradient-to-br from-primary to-secondary text-primary-content w-24 h-24 sm:w-32 sm:h-32 rounded-3xl ring-4 ring-primary/30 ring-offset-base-100 ring-offset-4 shadow-2xl">
            <span class="text-3xl sm:text-4xl">{personal.name.split(' ').map(n => n[0]).join('')}</span>
          </div>
        </div>

        <h1 class="text-display-lg font-display mb-4 sm:mb-6 text-base-content">
          About <span class="text-primary">Me</span>
        </h1>
        <p class="text-lg sm:text-xl lg:text-2xl text-base-content/80 leading-relaxed max-w-3xl mx-auto font-light">
          {personal.tagline || "Building scalable systems and crafting digital experiences that make a difference."}
        </p>

        <!-- Fun Facts Grid -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4 mt-8 sm:mt-10 lg:mt-12 max-w-2xl mx-auto">
          {funFacts.map(fact => (
            <div class="card bg-base-100/80 backdrop-blur-sm shadow-lg border border-base-content/10">
              <div class="card-body p-4 text-center">
                <p class="text-xs text-base-content/60 uppercase tracking-wider mb-1">{fact.label}</p>
                <p class="font-bold text-base-content">{fact.value}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="py-12 sm:py-16 lg:py-24">
    <div class="container mx-auto px-4 max-w-6xl">
      <!-- Introduction -->
      <div class="prose lg:prose-xl max-w-none mb-10 sm:mb-12 lg:mb-16">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="text-3xl font-display font-bold text-base-content mb-6">
              Hello, I'm {personal.name} 👋
            </h2>
            <div class="space-y-5">
              {personal.summary.map((paragraph) => (
                <p class="text-lg text-base-content/80 leading-relaxed">
                  {paragraph}
                </p>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Journey Timeline -->
      <div class="mb-16">
        <h2 class="text-3xl font-display font-bold text-center mb-12">
          My <span class="text-secondary">Journey</span>
        </h2>

        <!-- Timeline -->
        <div class="relative">
          <!-- Timeline line -->
          <div class="absolute left-1/2 transform -translate-x-1/2 h-full w-1 bg-gradient-to-b from-primary via-secondary to-accent hidden md:block"></div>

          <div class="space-y-12">
            {journeyMilestones.map((milestone, index) => {
              const isEven = index % 2 === 0
              return (
                <div class={`flex items-center gap-8 ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
                  <!-- Content -->
                  <div class={`flex-1 ${isEven ? 'md:text-right' : 'md:text-left'}`}>
                    <div class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105">
                      <div class="card-body">
                        <div class="badge badge-primary mb-2">{milestone.year}</div>
                        <h3 class="text-xl font-bold text-base-content">{milestone.title}</h3>
                        <p class="text-base-content/70">{milestone.description}</p>
                      </div>
                    </div>
                  </div>

                  <!-- Timeline node -->
                  <div class="flex-shrink-0 relative z-10">
                    <div class="w-16 h-16 bg-gradient-to-br from-primary to-secondary rounded-full flex items-center justify-center shadow-xl border-4 border-base-100">
                      <span class="text-2xl">
                        {milestone.icon === 'graduation' && '🎓'}
                        {milestone.icon === 'code' && '💻'}
                        {milestone.icon === 'cloud' && '☁️'}
                        {milestone.icon === 'devices' && '📱'}
                        {milestone.icon === 'rocket' && '🚀'}
                      </span>
                    </div>
                  </div>

                  <!-- Spacer for alignment -->
                  <div class="flex-1 hidden md:block"></div>
                </div>
              )
            })}
          </div>
        </div>
      </div>

      <!-- What Drives Me -->
      <div class="grid md:grid-cols-2 gap-8 mb-16">
        <div class="card bg-gradient-to-br from-primary/10 to-transparent shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-2xl mb-4">
              <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
              What Drives Me
            </h3>
            <p class="text-base-content/80 leading-relaxed">
              I'm passionate about creating technology that makes a real difference. Whether it's optimizing cloud infrastructure, building real-time systems, or designing intuitive interfaces, I'm driven by the impact of well-crafted software.
            </p>
          </div>
        </div>

        <div class="card bg-gradient-to-br from-secondary/10 to-transparent shadow-xl">
          <div class="card-body">
            <h3 class="card-title text-2xl mb-4">
              <svg class="w-8 h-8 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
              Continuous Learning
            </h3>
            <p class="text-base-content/80 leading-relaxed mb-4">
              {currentLearning}
            </p>
            <div class="flex flex-wrap gap-2">
              <div class="badge badge-outline">AWS Architecture</div>
              <div class="badge badge-outline">Cloud Certifications</div>
              <div class="badge badge-outline">Modern DevOps</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Interests - Visual Cards -->
      <div class="mb-16">
        <h2 class="text-3xl font-display font-bold text-center mb-12">
          Professional <span class="text-accent">Interests</span>
        </h2>
        <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto">
          {interests.map((interest, index) => {
            const icons = ['🎯', '☁️', '📱', '⚡', '🔒', '🚀']
            return (
              <div class="card h-full bg-base-100 shadow-lg hover:shadow-xl transition-shadow duration-300 border border-base-content/10">
                <div class="card-body p-6 sm:p-7">
                  <div class="text-3xl" aria-hidden="true">{icons[index % icons.length]}</div>
                  <h3 class="card-title text-xl text-primary leading-snug">{interest.title}</h3>
                  {interest.description && (
                    <p class="text-base-content/70 text-sm leading-relaxed">{interest.description}</p>
                  )}
                  {interest.items && interest.items.length > 0 && (
                    <ul class="mt-2 space-y-3 border-t border-base-content/10 pt-4">
                      {interest.items.map(item => (
                        <li class="text-base-content/70 text-sm leading-relaxed flex items-start gap-3">
                          <svg class="w-4 h-4 mt-0.5 text-primary flex-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                          </svg>
                          <span>{item}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            )
          })}
        </div>
      </div>

      <!-- Education -->
      <div class="card bg-gradient-to-br from-primary/5 to-secondary/5 shadow-xl mb-16">
        <div class="card-body">
          <div class="flex flex-col md:flex-row gap-6 items-start">
            <div class="flex-shrink-0">
              <div class="w-20 h-20 bg-primary/20 rounded-2xl flex items-center justify-center">
                <span class="text-4xl">🎓</span>
              </div>
            </div>
            <div class="flex-1">
              <h3 class="text-2xl font-bold text-base-content mb-2">{education.degree}</h3>
              <p class="text-base-content/70 text-lg mb-3">{education.institution}</p>
              <div class="flex flex-wrap gap-2 mb-4">
                <div class="badge badge-primary">{education.period}</div>
                <div class="badge badge-outline">{education.location}</div>
              </div>
              <p class="text-base-content/80 leading-relaxed">
                Strong foundation in algorithms, data structures, software engineering principles, and system design that continues to guide my approach to building robust, scalable systems.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <CallToAction cta={cta} variant="minimal" />
      </div>
    </div>
  </section>
</Layout>
