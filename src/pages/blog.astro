---
import Layout from '@/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import { portfolioData } from '@/data/portfolio'
import DynamicImage from '@/components/DynamicImage.astro'

const { ctas } = portfolioData
const cta = ctas.blog

// Get all blog posts from the content collection
const allPosts = await getCollection('blog')

// Sort posts by date (newest first) and featured status
const sortedPosts = allPosts.sort((a, b) => {
  // Featured posts first
  if (a.data.featured && !b.data.featured) return -1
  if (!a.data.featured && b.data.featured) return 1
  
  // Then by publish date (newest first)
  return new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
})

// Get unique categories and tags
const categories = [...new Set(allPosts.map(post => post.data.category).filter(Boolean))]
const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))]
---

<Layout title="Blog - Nilushan Silva" description="Technical blog covering full-stack development, cloud architecture, IoT solutions, and software engineering best practices.">
  <!-- Page Header -->
  <section class="hero relative overflow-hidden tech-grid py-20">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 animated-gradient opacity-30"></div>

    <div class="hero-content text-center relative z-10">
      <div class="max-w-xl">
        <!-- Section label -->
        <div class="inline-block mb-4">
          <span class="font-mono text-sm text-primary uppercase tracking-widest px-4 py-2 bg-primary/10 rounded-full border border-primary/20">
            &lt; Insights /&gt;
          </span>
        </div>

        <h1 class="text-4xl lg:text-6xl font-display font-bold mb-6 text-base-content">
          Technical <span class="text-primary">Blog</span>
        </h1>
        <p class="text-lg lg:text-xl text-base-content/70 max-w-3xl mx-auto leading-relaxed mb-8">
          Insights on full-stack development, cloud architecture, IoT solutions, and software engineering best practices from 15+ years of experience.
        </p>
        
        <!-- Categories Filter -->
        <div class="flex flex-wrap justify-center gap-2">
          {categories.map((category) => (
            <div class="badge badge-outline badge-lg">{category}</div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <article class="card bg-base-100 shadow-xl hover:shadow-2xl transition-all duration-500 group glass border border-base-content/5 hover:border-primary/20 relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-primary via-secondary to-accent opacity-50 group-hover:opacity-100 transition-opacity"></div>
            <figure class="h-48 overflow-hidden">
              {post.data.image ? (
                <DynamicImage
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full bg-gradient-to-br from-primary/20 to-secondary/20 flex items-center justify-center">
                  <div class="text-center text-base-content/60">
                    <svg class="w-16 h-16 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                    </svg>
                    <p class="text-base font-medium">Blog Post</p>
                  </div>
                </div>
              )}
            </figure>
            
            <div class="card-body">
              <div class="flex items-start justify-between mb-2">
                <h2 class="card-title text-base-content flex-1 line-clamp-2">
                  {post.data.title}
                  {post.data.featured && (
                    <div class="badge badge-primary badge-sm">Featured</div>
                  )}
                </h2>
              </div>
              
              <!-- Meta Information -->
              <div class="flex items-center gap-4 text-base text-base-content/70 mb-3">
                <div class="flex items-center gap-1">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <time>{new Date(post.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
                </div>
                {post.data.category && (
                  <div class="badge badge-ghost badge-sm">{post.data.category}</div>
                )}
              </div>
              
              <p class="text-base-content/80 text-base line-clamp-3 mb-4">
                {post.data.description}
              </p>
              
              <!-- Tags -->
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1 mb-4">
                  {post.data.tags.slice(0, 3).map((tag) => (
                    <div class="badge badge-outline badge-sm">{tag}</div>
                  ))}
                  {post.data.tags.length > 3 && (
                    <div class="badge badge-ghost badge-sm">+{post.data.tags.length - 3}</div>
                  )}
                </div>
              )}
              
              <div class="card-actions justify-end">
                <a
                  href={`/blog/${post.id}`}
                  class="btn btn-primary btn-sm track-blog-read"
                  data-blog-title={post.data.title}
                  data-blog-category={post.data.category}
                >
                  Read More
                  <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
      
      <!-- Call to Action Section -->
      <div class="mt-16">
        <section class="py-24 lg:py-32 relative overflow-hidden rounded-3xl">
          <!-- Animated gradient background -->
          <div class="absolute inset-0 animated-gradient opacity-20"></div>
          <!-- Tech grid overlay -->
          <div class="absolute inset-0 tech-grid opacity-30"></div>

          <div class="relative z-10">
            <div class="max-w-4xl mx-auto text-center px-4">
              <!-- Section label -->
              <div class="inline-block mb-6">
                <span class="font-mono text-sm text-primary uppercase tracking-widest px-4 py-2 bg-primary/10 rounded-full border border-primary/20">
                  &lt; {cta.label} /&gt;
                </span>
              </div>

              <h2 class="text-4xl lg:text-6xl font-display font-bold mb-6 text-base-content">
                {cta.title.split(' ').slice(0, -1).join(' ')} <span class="text-primary">{cta.title.split(' ').slice(-1)}</span>
              </h2>

              <p class="text-lg lg:text-2xl text-base-content/80 mb-12 leading-relaxed max-w-3xl mx-auto">
                {cta.description}
              </p>

              <!-- CTA Buttons -->
              <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a href={cta.primaryButton.href} class="btn btn-primary btn-lg font-display shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 glow-hover group">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 mr-2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                  <span>{cta.primaryButton.text}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 ml-2 transition-transform group-hover:translate-x-1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>

                <a href={cta.secondaryButton.href} class="btn btn-outline btn-lg font-display shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 group border-2">
                  <span>{cta.secondaryButton.text}</span>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 ml-2 transition-transform group-hover:translate-x-1">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </section>
</Layout>

<!-- Analytics Tracking Script -->
<script>
  import { trackBlogView } from '@/lib/analytics';

  // Track blog read clicks
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const link = target.closest('.track-blog-read') as HTMLElement;

    if (link) {
      const blogTitle = link.getAttribute('data-blog-title');
      const blogCategory = link.getAttribute('data-blog-category');

      if (blogTitle) {
        trackBlogView({
          post_title: blogTitle,
          post_category: blogCategory || 'uncategorized',
        });
      }
    }
  });
</script>
