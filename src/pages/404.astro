---
export const prerender = true;

import Layout from "@/layouts/Layout.astro";
import { navigation } from "@/data/portfolio";
---

<Layout
  title="404 - Page Not Found | Nilushan Silva"
  description="The page you're looking for doesn't exist."
>
  <div class="min-h-screen flex items-center justify-center bg-base-200 px-4">
    <div class="max-w-2xl mx-auto text-center">
      <!-- 404 Illustration -->
      <div class="mb-8">
        <div class="text-9xl font-bold text-primary/20 select-none">404</div>
      </div>

      <!-- Error Message -->
      <div class="mb-8">
        <h1 class="text-4xl lg:text-5xl font-bold text-base-content mb-4">
          Page Not Found
        </h1>
        <p class="text-lg text-base-content/70 mb-2">
          Oops! The page you're looking for seems to have wandered off.
        </p>
        <p class="text-base text-base-content/60">
          It might have been moved, deleted, or perhaps it never existed in the first place.
        </p>
      </div>

      <!-- Search Suggestions -->
      <div class="bg-base-100 rounded-box p-6 mb-8 shadow-lg">
        <h2 class="text-xl font-semibold text-base-content mb-4">
          Try one of these instead:
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
          {navigation.map((item) => (
            <a
              href={item.href}
              class="btn btn-outline btn-primary btn-sm"
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>

      <!-- Home Button -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a href="/" class="btn btn-primary btn-lg gap-2">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
            ></path>
          </svg>
          Back to Home
        </a>
        <button
          onclick="window.history.back()"
          class="btn btn-ghost btn-lg gap-2"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3"
            ></path>
          </svg>
          Go Back
        </button>
      </div>

      <!-- Fun Message -->
      <div class="mt-12 text-sm text-base-content/40">
        <p>Lost in the cloud? Don't worry, I'm a Cloud Engineer - I'll help you find your way!</p>
      </div>
    </div>
  </div>
</Layout>
