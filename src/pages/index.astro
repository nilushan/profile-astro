---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/Hero.astro";
import ExperienceTimeline from "@/components/sections/ExperienceTimeline.astro";
import ProjectsGallery from "@/components/sections/ProjectsGallery.astro";
import SkillsGrid from "@/components/sections/SkillsGrid.astro";
import CallToAction from "@/components/CallToAction.astro";
import { portfolioData } from "@/data/portfolio";
import { getCollection } from "astro:content";

const { personal, experience, skills, skillCategories, ctas } = portfolioData;
const cta = ctas.home;

// Get all projects and filter for featured ones
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((project) => project.data.featured === true)
  .sort((a, b) => {
    // Sort by date if available, otherwise by title
    const dateA = a.data.dates?.start || a.data.period;
    const dateB = b.data.dates?.start || b.data.period;
    return dateB > dateA ? 1 : -1;
  })
  .slice(0, 3);

const recentExperience = experience.slice(0, 2);
---

<Layout>
  <!-- Hero Section -->
  <Hero />

  <!-- About Preview Section -->
