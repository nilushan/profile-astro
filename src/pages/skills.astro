---
import Layout from '@/layouts/Layout.astro'
import SkillsGrid from '@/components/sections/SkillsGrid.astro'
import CallToAction from '@/components/CallToAction.astro'
import { portfolioData } from '@/data/portfolio'

const { skills, skillCategories, ctas} = portfolioData
const cta = ctas.skills
---

<Layout title="Skills - Nilushan Silva" description="Explore my comprehensive technical skill set including programming languages, frameworks, cloud platforms, and development tools.">
  <!-- Page Header - Bold, Distinctive Design -->
  <section class="hero min-h-[600px] relative overflow-hidden bg-base-100">
    <!-- Dynamic tech grid background -->
    <div class="absolute inset-0 tech-grid opacity-40"></div>
    <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-transparent to-accent/5"></div>

    <!-- Geometric accent shapes -->
    <div class="absolute top-20 right-10 w-32 h-32 border-2 border-primary/20 rotate-12 rounded-3xl"></div>
    <div class="absolute bottom-20 left-10 w-24 h-24 bg-secondary/10 -rotate-12 rounded-2xl"></div>

    <div class="hero-content text-center relative z-10 py-20 lg:py-32">
      <div class="max-w-4xl">
        <!-- Overline with different style -->
        <div class="flex items-center gap-3 mb-6 justify-center">
          <div class="h-px w-12 bg-gradient-to-r from-transparent to-primary"></div>
          <span class="font-mono text-xs text-primary uppercase tracking-[0.2em] font-semibold">
            Tech Stack
          </span>
          <div class="h-px w-12 bg-gradient-to-l from-transparent to-primary"></div>
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-8xl font-display font-bold mb-8 text-base-content text-center leading-none">
          Skills &
          <span class="block text-primary mt-2">Expertise</span>
        </h1>

        <p class="text-lg lg:text-2xl text-base-content/60 max-w-2xl mx-auto text-center leading-relaxed font-light">
          {skillCategories.reduce((total, cat) => total + cat.skills.length, 0)}+ technologies mastered across {skillCategories.length} domains
        </p>
      </div>
    </div>
  </section>

  <!-- Skills Grid -->
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <SkillsGrid
        skillCategories={skillCategories}
        showAll={true}
      />
    </div>
  </section>

  <!-- Cloud Platforms - Streamlined, Visual Design -->
  <section class="py-16 lg:py-24 bg-base-200/50">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <!-- Section Header -->
        <div class="text-center mb-12">
          <div class="flex items-center gap-3 mb-4 justify-center">
            <div class="h-px w-8 bg-gradient-to-r from-transparent to-info"></div>
            <span class="font-mono text-xs text-info uppercase tracking-[0.2em]">
              Cloud Infrastructure
            </span>
            <div class="h-px w-8 bg-gradient-to-l from-transparent to-info"></div>
          </div>
          <h2 class="text-3xl lg:text-5xl font-display font-bold text-base-content mb-4">
            Cloud <span class="text-info">Platforms</span>
          </h2>
        </div>

        <!-- Cloud Platform Cards - Compact & Visual -->
        <div class="grid md:grid-cols-3 gap-6 auto-rows-fr">
          <!-- Google Cloud Platform -->
          <div class="card bg-base-100 shadow-xl border border-success/20 hover:shadow-2xl transition-shadow duration-300">
            <div class="card-body p-6">
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-success/20 rounded-xl flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 text-success">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-display font-bold text-lg">Google Cloud</h3>
                      <p class="text-xs text-base-content/60 font-mono">6+ years</p>
                    </div>
                  </div>
                  <div class="badge badge-success badge-sm font-mono">Expert</div>
                </div>

                <div class="flex flex-wrap gap-1">
                  {skills.cloud.gcp.actively.slice(0, 10).map((service) => (
                    <div class="badge badge-outline badge-xs text-[10px] font-mono">{service}</div>
                  ))}
                  {skills.cloud.gcp.actively.length > 10 && (
                    <div class="badge badge-ghost badge-xs text-[10px] font-mono">+{skills.cloud.gcp.actively.length - 10}</div>
                  )}
                </div>
              </div>
            </div>

          <!-- AWS -->
          <div class="card bg-base-100 shadow-xl border border-warning/20 hover:shadow-2xl transition-shadow duration-300">
            <div class="card-body p-6">
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-warning/20 rounded-xl flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 text-warning">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-display font-bold text-lg">Amazon AWS</h3>
                      <p class="text-xs text-base-content/60 font-mono">Learning</p>
                    </div>
                  </div>
                  <div class="badge badge-warning badge-sm font-mono">Growing</div>
                </div>

                <div class="flex flex-wrap gap-1">
                  {skills.cloud.aws.familiar.map((service) => (
                    <div class="badge badge-outline badge-xs text-[10px] font-mono">{service}</div>
                  ))}
                </div>
              </div>
            </div>

          <!-- Azure -->
          <div class="card bg-base-100 shadow-xl border border-accent/20 hover:shadow-2xl transition-shadow duration-300">
            <div class="card-body p-6">
                <div class="flex items-start justify-between mb-4">
                  <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-accent/20 rounded-xl flex items-center justify-center">
                      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 text-accent">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                      </svg>
                    </div>
                    <div>
                      <h3 class="font-display font-bold text-lg">Azure</h3>
                      <p class="text-xs text-base-content/60 font-mono">Familiar</p>
                    </div>
                  </div>
                  <div class="badge badge-accent badge-sm font-mono">Basic</div>
                </div>

                <div class="flex flex-wrap gap-1">
                  {skills.cloud.azure.familiar.map((service) => (
                    <div class="badge badge-outline badge-xs text-[10px] font-mono">{service}</div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Compact Proficiency Note -->
        <div class="mt-12 text-center">
          <p class="text-base-content/50 text-sm font-mono">
            <span class="text-success">●</span> Expert: 5+ years production  ·
            <span class="text-warning">●</span> Growing: Actively learning  ·
            <span class="text-accent">●</span> Basic: Foundational knowledge
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <CallToAction cta={cta} />
      </div>
    </div>
  </section>
</Layout>
