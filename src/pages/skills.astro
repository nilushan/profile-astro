  </section> -->

  <!-- Skills Grid -->
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4">
      <SkillsGrid 
        skillCategories={skillCategories} 
        showAll={true}
      />
    </div>
  </section>

  <!-- Cloud Platforms Comparison -->
  <section class="py-16 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold mb-4 text-base-content">
          Cloud Platform Experience
        </h2>
        <p class="text-lg text-base-content/70">
          My experience across different cloud platforms and services
        </p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        <!-- Google Cloud Platform -->
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-primary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-7 w-7 text-primary">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold">Google Cloud</h3>
                <div class="badge badge-success">Expert</div>
              </div>
            </div>
            
            <p class="text-base text-base-content/80 mb-4">6+ years of production experience</p>
            
            <div class="space-y-2">
              <h4 class="font-semibold text-base">Actively Using:</h4>
              <div class="flex flex-wrap gap-1">
                {skills.cloud.gcp.actively.slice(0, 8).map((service) => (
                  <div class="badge badge-primary badge-sm">{service}</div>
                ))}
              </div>
            </div>
          </div>
        </div>
        
        <!-- AWS -->
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-secondary/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-7 w-7 text-secondary">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold">Amazon AWS</h3>
                <div class="badge badge-warning">Learning</div>
              </div>
            </div>
            
            <p class="text-base text-base-content/80 mb-4">Currently expanding knowledge</p>
            
            <div class="space-y-2">
              <h4 class="font-semibold text-base">Familiar With:</h4>
              <div class="flex flex-wrap gap-1">
                {skills.cloud.aws.familiar.slice(0, 6).map((service) => (
                  <div class="badge badge-secondary badge-sm">{service}</div>
                ))}
              </div>
            </div>
          </div>
        </div>
        
        <!-- Azure -->
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-accent/10 rounded-full flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-7 w-7 text-accent">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xl font-bold">Microsoft Azure</h3>
                <div class="badge badge-accent">Familiar</div>
              </div>
            </div>
            
            <p class="text-base text-base-content/80 mb-4">Basic understanding and usage</p>
            
            <div class="space-y-2">
              <h4 class="font-semibold text-base">Familiar With:</h4>
              <div class="flex flex-wrap gap-1">
                {skills.cloud.azure.familiar.map((service) => (
                  <div class="badge badge-accent badge-sm">{service}</div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skill Proficiency Legend -->
  <section class="py-16">
    <div class="container mx-auto px-4">
        <div class="card bg-gradient-to-r from-info/10 to-accent/10 shadow-lg">
          <div class="card-body">
            <h3 class="text-2xl font-bold mb-6 text-center">Skill Proficiency Guide</h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              <div class="text-center">
                <div class="w-16 h-16 bg-success/10 rounded-full flex items-center justify-center mx-auto mb-3">
                  <div class="badge badge-success">Expert</div>
                </div>
                <h4 class="font-semibold mb-2">Expert Level</h4>
                <p class="text-base text-base-content/70">5+ years of production experience, can mentor others, deep understanding of best practices</p>
              </div>
              <div class="text-center">
                <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                  <div class="badge badge-primary">Advanced</div>
                </div>
                <h4 class="font-semibold mb-2">Advanced Level</h4>
                <p class="text-base text-base-content/70">3+ years experience, comfortable with complex projects, good understanding of patterns</p>
              </div>
              <div class="text-center">
                <div class="w-16 h-16 bg-secondary/10 rounded-full flex items-center justify-center mx-auto mb-3">
                  <div class="badge badge-secondary">Intermediate</div>
                </div>
                <h4 class="font-semibold mb-2">Intermediate Level</h4>
                <p class="text-base text-base-content/70">1-3 years experience, can work independently, understand core concepts</p>
              </div>
              <div class="text-center">
                <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mx-auto mb-3">
                  <div class="badge badge-accent">Familiar</div>
                </div>
                <h4 class="font-semibold mb-2">Familiar Level</h4>
                <p class="text-base text-base-content/70">Basic understanding, can work with guidance, learning actively</p>
              </div>
            </div>
          </div>
        </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-24 lg:py-32 relative overflow-hidden">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 animated-gradient opacity-20"></div>
    <!-- Tech grid overlay -->
    <div class="absolute inset-0 tech-grid opacity-30"></div>

    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Section label -->
        <div class="inline-block mb-6">
          <span class="font-mono text-sm text-primary uppercase tracking-widest px-4 py-2 bg-primary/10 rounded-full border border-primary/20">
            &lt; {cta.label} /&gt;
          </span>
        </div>

        <h2 class="text-4xl lg:text-6xl font-display font-bold mb-6 text-base-content">
          {cta.title.split(' ').slice(0, -1).join(' ')} <span class="text-primary">{cta.title.split(' ').slice(-1)}</span>
        </h2>

        <p class="text-lg lg:text-2xl text-base-content/80 mb-12 leading-relaxed max-w-3xl mx-auto">
          {cta.description}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={cta.primaryButton.href} class="btn btn-primary btn-lg font-display shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 glow-hover group">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 mr-2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
            <span>{cta.primaryButton.text}</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 ml-2 transition-transform group-hover:translate-x-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>

          <a href={cta.secondaryButton.href} class="btn btn-outline btn-lg font-display shadow-xl hover:shadow-2xl hover:scale-105 transition-all duration-300 group border-2">
            <span>{cta.secondaryButton.text}</span>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-5 w-5 ml-2 transition-transform group-hover:translate-x-1">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
