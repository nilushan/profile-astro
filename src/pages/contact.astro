---
import Layout from '@/layouts/Layout.astro'
import { portfolioData } from '@/data/portfolio'

const { personal } = portfolioData
---

<Layout title="Contact - Nilushan Silva" description="Get in touch with me for opportunities, collaborations, or just to say hello. I'm always interested in connecting with fellow developers and potential clients.">
  <!-- Page Header -->
  <section class="hero bg-gradient-to-r from-primary/10 to-secondary/10 py-20">
    <div class="hero-content text-center">
      <div class="max-w-3xl">
        <h1 class="text-4xl lg:text-5xl font-bold mb-6 text-base-content">
          Let's Connect
        </h1>
        <p class="text-lg text-base-content/70">
          I'm always interested in new opportunities, collaborations, and meaningful conversations about technology.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Information -->
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Email -->
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body items-center text-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-primary mb-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              <h3 class="card-title text-xl mb-2">Email</h3>
              <a href={`mailto:${personal.email}`} class="link link-primary text-lg">{personal.email}</a>
            </div>
          </div>

          <!-- Location -->
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body items-center text-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12 text-secondary mb-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
              </svg>
              <h3 class="card-title text-xl mb-2">Location</h3>
              <p class="text-lg">{personal.location}</p>
            </div>
          </div>

          <!-- LinkedIn -->
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body items-center text-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-12 h-12 text-info mb-4">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              <h3 class="card-title text-xl mb-2">LinkedIn</h3>
              <a href={`https://linkedin.com/in/${personal.social.linkedin}`} target="_blank" rel="noopener noreferrer" class="link link-info text-lg">View Profile</a>
            </div>
          </div>

          <!-- GitHub -->
          <div class="card bg-base-100 shadow-lg">
            <div class="card-body items-center text-center">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-12 h-12 text-accent mb-4">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              <h3 class="card-title text-xl mb-2">GitHub</h3>
              <a href={`https://github.com/${personal.social.github}`} target="_blank" rel="noopener noreferrer" class="link link-accent text-lg">View Projects</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="text-3xl lg:text-4xl font-bold mb-4 text-base-content">
            Frequently Asked Questions
          </h2>
          <p class="text-lg text-base-content/70">
            Common questions about working with me and my services
          </p>
        </div>
        
        <div class="space-y-4">
          <div class="collapse collapse-plus bg-base-100 shadow-lg">
            <input type="radio" name="faq-accordion" checked />
            <div class="collapse-title text-lg font-semibold">
              What types of projects do you work on?
            </div>
            <div class="collapse-content">
              <p class="text-base-content/80">
                I specialize in full-stack web applications, cloud architecture (particularly GCP), IoT platforms, 
                and real-time systems. I'm particularly passionate about projects involving TypeScript, React, 
                Node.js, and scalable cloud infrastructure. I also enjoy working on complex technical challenges 
                that require innovative solutions.
              </p>
            </div>
          </div>
          
          <div class="collapse collapse-plus bg-base-100 shadow-lg">
            <input type="radio" name="faq-accordion" />
            <div class="collapse-title text-lg font-semibold">
              Are you available for remote work?
            </div>
            <div class="collapse-content">
              <p class="text-base-content/80">
                Yes, I'm very comfortable with remote work and have been working remotely successfully for several years. 
                I'm experienced with distributed teams and asynchronous communication. I'm based in Queensland, Australia, 
                but I'm flexible with time zones for international collaboration.
              </p>
            </div>
          </div>
          
          <div class="collapse collapse-plus bg-base-100 shadow-lg">
            <input type="radio" name="faq-accordion" />
            <div class="collapse-title text-lg font-semibold">
              What's your preferred way to communicate?
            </div>
            <div class="collapse-content">
              <p class="text-base-content/80">
                I prefer email for initial contact and detailed discussions. For ongoing projects, I'm comfortable 
                with Slack, Microsoft Teams, or similar platforms. I believe in clear, regular communication and 
                am always available for video calls when needed to discuss complex technical matters.
              </p>
            </div>
          </div>
          
          <div class="collapse collapse-plus bg-base-100 shadow-lg">
            <input type="radio" name="faq-accordion" />
            <div class="collapse-title text-lg font-semibold">
              Do you provide consulting services?
            </div>
            <div class="collapse-content">
              <p class="text-base-content/80">
                Yes, I offer technical consulting services including architecture reviews, code audits, 
                cloud migration planning, and technology strategy. I can also provide mentoring for development 
                teams looking to improve their practices with modern tools and methodologies.
              </p>
            </div>
          </div>
          
          <div class="collapse collapse-plus bg-base-100 shadow-lg">
            <input type="radio" name="faq-accordion" />
            <div class="collapse-title text-lg font-semibold">
              What's your typical project timeline?
            </div>
            <div class="collapse-content">
              <p class="text-base-content/80">
                Project timelines vary greatly depending on scope and complexity. I believe in agile development 
                with regular milestones and deliverables. For new projects, I typically start with a detailed 
                discovery phase to understand requirements and provide accurate estimates. I'm committed to 
                delivering quality work on time and within budget.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
