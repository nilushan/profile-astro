---
import Layout from '@/layouts/Layout.astro'
import { portfolioData } from '@/data/portfolio'

const { personal } = portfolioData
---

<Layout title="Contact - Nilushan Silva" description="Get in touch with me for opportunities, collaborations, or just to say hello. I'm always interested in connecting with fellow developers and potential clients.">
  <!-- Page Header - Compact and Focused -->
  <section class="hero min-h-[500px] relative overflow-hidden">
    <!-- Animated gradient background -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary/10 via-secondary/5 to-accent/10"></div>
    <div class="absolute inset-0 tech-grid opacity-20"></div>

    <div class="hero-content text-center relative z-10 w-full py-20">
      <div class="max-w-4xl mx-auto">
        <div class="inline-block mb-6">
          <span class="font-mono text-sm text-primary uppercase tracking-widest px-4 py-2 bg-primary/10 rounded-full border border-primary/20">
            Get In Touch
          </span>
        </div>
        <h1 class="text-5xl lg:text-7xl font-display font-bold mb-6 text-base-content leading-tight">
          Let's <span class="text-primary">Connect</span>
        </h1>
        <p class="text-xl lg:text-2xl text-base-content/70 max-w-3xl mx-auto leading-relaxed mb-8">
          I'm always interested in new opportunities, collaborations, and meaningful conversations about technology.
        </p>
        <!-- Quick contact hint -->
        <div class="flex items-center justify-center gap-2 text-base-content/60">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <p class="text-sm">Email is the best way to reach me</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Methods - Simplified to Essentials -->
  <section class="py-16 lg:py-24">
    <div class="container mx-auto px-4 max-w-5xl">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Email - Primary Contact -->
        <div class="card bg-gradient-to-br from-primary/10 to-transparent shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105 border border-primary/20">
          <div class="card-body items-center text-center">
            <div class="w-16 h-16 bg-primary/20 rounded-2xl flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-8 h-8 text-primary">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-base-content mb-2">Email</h3>
            <p class="text-sm text-base-content/60 mb-3">Best way to reach me</p>
            <a href={`mailto:${personal.email}`} class="btn btn-primary btn-sm gap-2">
              <span>Send Email</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
            <p class="text-xs text-base-content/50 mt-2">{personal.email}</p>
          </div>
        </div>

        <!-- LinkedIn - Professional Network -->
        <div class="card bg-gradient-to-br from-secondary/10 to-transparent shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105 border border-secondary/20">
          <div class="card-body items-center text-center">
            <div class="w-16 h-16 bg-secondary/20 rounded-2xl flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8 text-secondary">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-base-content mb-2">LinkedIn</h3>
            <p class="text-sm text-base-content/60 mb-3">Professional network</p>
            <a href={`https://linkedin.com/in/${personal.social.linkedin}`} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm gap-2">
              <span>View Profile</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
            <p class="text-xs text-base-content/50 mt-2">@{personal.social.linkedin}</p>
          </div>
        </div>

        <!-- GitHub - Open Source -->
        <div class="card bg-gradient-to-br from-accent/10 to-transparent shadow-xl hover:shadow-2xl transition-all duration-300 hover:scale-105 border border-accent/20">
          <div class="card-body items-center text-center">
            <div class="w-16 h-16 bg-accent/20 rounded-2xl flex items-center justify-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-8 h-8 text-accent">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-base-content mb-2">GitHub</h3>
            <p class="text-sm text-base-content/60 mb-3">Open source code</p>
            <a href={`https://github.com/${personal.social.github}`} target="_blank" rel="noopener noreferrer" class="btn btn-accent btn-sm gap-2">
              <span>View Projects</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
            <p class="text-xs text-base-content/50 mt-2">@{personal.social.github}</p>
          </div>
        </div>
      </div>

      <!-- Location info as subtle footer -->
      <div class="text-center mt-12">
        <div class="inline-flex items-center gap-2 text-base-content/60">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
          </svg>
          <span>Based in {personal.location} • AEST (GMT+10)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section - Visual and Concise -->
  <section class="py-16 lg:py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-base-200/50 to-base-100"></div>

    <div class="container mx-auto px-4 max-w-6xl relative z-10">
      <div class="text-center mb-16">
        <div class="inline-block mb-4">
          <span class="font-mono text-sm text-accent uppercase tracking-widest px-4 py-2 bg-accent/10 rounded-full border border-accent/20">
            Quick Answers
          </span>
        </div>
        <h2 class="text-4xl lg:text-5xl font-display font-bold mb-6 text-base-content">
          Common <span class="text-accent">Questions</span>
        </h2>
        <p class="text-lg text-base-content/70 max-w-2xl mx-auto">
          Everything you need to know about working together
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mb-12">
        <!-- Question 1 -->
        <div class="card bg-base-100 shadow-xl border border-base-content/5 hover:shadow-2xl transition-all duration-300">
          <div class="card-body">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-primary/20 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
                  </svg>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold text-base-content mb-3">What do you specialize in?</h3>
                <p class="text-base-content/70 leading-relaxed">
                  Full-stack web applications, cloud architecture (GCP), IoT platforms, and real-time systems.
                  I'm passionate about TypeScript, React, Node.js, and scalable cloud infrastructure.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Question 2 -->
        <div class="card bg-base-100 shadow-xl border border-base-content/5 hover:shadow-2xl transition-all duration-300">
          <div class="card-body">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-secondary/20 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                  </svg>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold text-base-content mb-3">Remote work availability?</h3>
                <p class="text-base-content/70 leading-relaxed">
                  Yes! I've been working remotely for years with distributed teams across different time zones.
                  Based in Queensland, Australia (AEST), but flexible for international collaboration.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Question 3 -->
        <div class="card bg-base-100 shadow-xl border border-base-content/5 hover:shadow-2xl transition-all duration-300">
          <div class="card-body">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-accent/20 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
                  </svg>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold text-base-content mb-3">Best way to communicate?</h3>
                <p class="text-base-content/70 leading-relaxed">
                  Email for initial contact and detailed discussions. For projects, I use Slack, Teams, or similar platforms.
                  Always available for video calls to discuss technical matters.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Question 4 -->
        <div class="card bg-base-100 shadow-xl border border-base-content/5 hover:shadow-2xl transition-all duration-300">
          <div class="card-body">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0">
                <div class="w-12 h-12 bg-info/20 rounded-xl flex items-center justify-center">
                  <svg class="w-6 h-6 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
                  </svg>
                </div>
              </div>
              <div class="flex-1">
                <h3 class="text-xl font-bold text-base-content mb-3">Consulting services?</h3>
                <p class="text-base-content/70 leading-relaxed">
                  Yes! I offer architecture reviews, code audits, cloud migration planning, and technology strategy.
                  Also available for team mentoring on modern development practices.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Additional Info Banner -->
      <div class="card bg-gradient-to-r from-primary/10 via-secondary/10 to-accent/10 border border-primary/20">
        <div class="card-body text-center">
          <p class="text-lg text-base-content/80">
            Have a specific question? <a href={`mailto:${personal.email}`} class="link link-primary font-semibold">Send me an email</a> and I'll get back to you within 24 hours.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
