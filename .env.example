# Environment Variables Template
# Copy this file to .env.local for local development

# Allow search engine indexing
# Set to 'true' in production, 'false' in development/preview
# Production builds automatically set this to true
PUBLIC_ALLOW_INDEXING=false

# Site URL (should match astro.config.mjs)
PUBLIC_SITE_URL=https://www.nilushansilva.info

# Google Analytics 4 (GA4) Configuration
# Get your Measurement ID from Google Analytics 4 dashboard (format: G-XXXXXXXXXX)
# Leave PUBLIC_ANALYTICS_ENABLED=false to disable analytics tracking
PUBLIC_GA_ID=G-W9Z3EXBDP1
PUBLIC_ANALYTICS_ENABLED=false
PUBLIC_CONSENT_MODE=false
